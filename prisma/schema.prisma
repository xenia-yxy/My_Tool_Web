generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  USER
}

enum NoteStatus {
  PRIVATE
  PUBLISHED
}

enum DailyPlanStatus {
  TODO
  DOING
  DONE
  CANCELED
}

enum DailyPlanPriority {
  LOW
  MEDIUM
  HIGH
}

enum DailyPlanQuadrant {
  DO_NOW
  SCHEDULE
  DELEGATE
  DELETE
}

enum WorkbenchSessionStatus {
  DRAFT
  RUNNING
  SUCCEEDED
  FAILED
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime?
  image         String?
  passwordHash  String?
  role          Role      @default(USER)
  authVersion   Int       @default(1)
  failedLoginCount Int     @default(0)
  lockedUntil   DateTime?
  lastLoginAt   DateTime?
  lastLoginIp   String?
  disabledAt    DateTime?
  passwordChangedAt DateTime?
  accounts      Account[]
  sessions      Session[]
  notes         Note[]
  aiImageAssets AiImageAsset[]
  aiImageJobs   AiImageJob[]
  ipPrototypeProjects IpPrototypeProject[]
  ipPrototypeGenerations IpPrototypeGeneration[]
  aiProviderCredentials AiProviderCredential[]
  websiteBookmarks WebsiteBookmark[]
    dailyPlanItems DailyPlanItem[]
    workbenchSessions WorkbenchSession[]
    menswearMaterials MenswearMaterial[]
    menswearModelProfiles MenswearModelProfile[]
    menswearProjects MenswearProject[]
    productCategories ProductCategory[]
    products Product[]
    creativeSkills CreativeSkill[]
    creativeCanvasSessions CreativeCanvasSession[]
    loginAudits   LoginAudit[]
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Note {
  id          String     @id @default(cuid())
  title       String
  slug        String     @unique
  excerpt     String?
  content     String     @db.Text
  status      NoteStatus @default(PRIVATE)
  authorId    String
  author      User       @relation(fields: [authorId], references: [id], onDelete: Cascade)
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([status, publishedAt])
  @@index([authorId])
}

model AiImageAsset {
  id          String   @id @default(cuid())
  mode        String
  sourceTool  String?
  status      String   @default("SUCCEEDED")
  jobId       String?
  title       String
  description String?  @db.Text
  caption     String?  @db.Text
  tags        String[] @default([])
  productKeywords String[] @default([])
  prompt      String   @db.Text
  imageUrl    String
  downloadUrl String
  fileName    String
  mimeType    String   @default("image/png")
  note        String?  @db.Text
  errorMessage String? @db.Text
  referenceImages String[] @default([])
  referenceLabels String[] @default([])
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId, createdAt])
  @@index([mode, createdAt])
  @@index([authorId, status, createdAt])
  @@index([jobId])
}

model AiImageJob {
  id          String   @id @default(cuid())
  mode        String
  sourceTool  String?
  status      String   @default("PENDING")
  title       String
  prompt      String   @db.Text
  batchCount  Int      @default(1)
  completedCount Int   @default(0)
  failedCount Int      @default(0)
  errorMessage String? @db.Text
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  startedAt   DateTime?
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId, createdAt])
  @@index([authorId, status, createdAt])
  @@index([mode, createdAt])
}

model MenswearMaterial {
  id           String   @id @default(cuid())
  authorId     String
  author       User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name         String
  category     String
  sourceType   String
  sourceUrl    String?
  rightsStatus String   @default("PRIVATE")
  imageUrl     String
  previewUrl   String?
  maskUrl      String?
  tags         String[] @default([])
  analysis     Json     @default("{}")
  promptNotes  String?  @db.Text
  qualityScore Int?
  completeness Int?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  modelImages  MenswearModelProfileImage[]
  projectRefs  MenswearProjectReference[]

  @@index([authorId, category, updatedAt])
}

model MenswearModelProfile {
  id                 String   @id @default(cuid())
  authorId           String
  author             User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name               String
  status             String   @default("DRAFT")
  profile            Json     @default("{}")
  faceLockStrength   Int      @default(90)
  bodyLockStrength   Int      @default(85)
  hairLockStrength   Int      @default(80)
  consentConfirmedAt DateTime?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  images             MenswearModelProfileImage[]
  projects           MenswearProject[]

  @@index([authorId, updatedAt])
}

model MenswearProject {
  id             String   @id @default(cuid())
  authorId       String
  author         User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  modelProfileId String?
  modelProfile   MenswearModelProfile? @relation(fields: [modelProfileId], references: [id], onDelete: SetNull)
  name           String
  status         String   @default("DRAFT")
  description    String?  @db.Text
  settings       Json     @default("{}")
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  references     MenswearProjectReference[]
  prompts        MenswearPromptVersion[]

  @@index([authorId, updatedAt])
}

model MenswearModelProfileImage {
  id         String   @id @default(cuid())
  profileId  String
  profile    MenswearModelProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  materialId String
  material   MenswearMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  role       String
  position   Int
  createdAt  DateTime @default(now())

  @@unique([profileId, role, position])
  @@index([materialId])
}

model MenswearProjectReference {
  id             String   @id @default(cuid())
  projectId      String
  project        MenswearProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  materialId     String
  material       MenswearMaterial @relation(fields: [materialId], references: [id], onDelete: Restrict)
  role           String
  policy         String
  fidelity       Int
  allowedChanges String[] @default([])
  position       Int
  createdAt      DateTime @default(now())

  @@unique([projectId, role, position])
  @@index([materialId])
}

model MenswearPromptVersion {
  id           String   @id @default(cuid())
  projectId    String
  project      MenswearProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  systemPrompt String   @db.Text
  userPrompt   String?  @db.Text
  finalPrompt  String   @db.Text
  jobId        String?
  createdAt    DateTime @default(now())

  @@index([projectId, createdAt])
}

model ProductCategory {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  name      String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  products  Product[]

  @@unique([authorId, name])
  @@index([authorId, sortOrder])
}

model Product {
  id          String   @id @default(cuid())
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  categoryId  String?
  category    ProductCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name        String
  description String?  @db.Text
  tags        String[] @default([])
  sellPoints  String[] @default([])
  scenes      String[] @default([])
  keywords    String[] @default([])
  aiAnalysis  Json     @default("{}")
  aiAnalyzedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  images      ProductImage[]

  @@index([authorId, updatedAt])
  @@index([authorId, categoryId])
}

model ProductImage {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imageUrl  String
  position  Int
  isPrimary Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([productId, position])
  @@index([productId, isPrimary])
}

model IpPrototypeProject {
  id          String   @id @default(cuid())
  name        String
  ipType      String
  description String?  @db.Text
  brandTone   String?  @db.Text
  authorId    String
  author      User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  generations IpPrototypeGeneration[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([authorId, updatedAt])
  @@index([authorId, ipType])
}

model IpPrototypeGeneration {
  id            String   @id @default(cuid())
  projectId     String
  project       IpPrototypeProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId      String
  author        User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ipType        String
  outputGoal    String
  title         String
  userPrompt    String   @db.Text
  prompt        String   @db.Text
  styleText     String?  @db.Text
  draftImageUrl String?
  styleImageUrl String?
  imageUrl      String
  downloadUrl   String
  fileName      String
  mimeType      String   @default("image/png")
  note          String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([authorId, createdAt])
  @@index([projectId, createdAt])
  @@index([ipType, outputGoal])
}

model AiProviderCredential {
  id              String   @id @default(cuid())
  provider        String
  displayName     String
  baseUrl         String?
  model           String
  encryptedApiKey String   @db.Text
  apiKeyPreview   String
  capabilities    String[] @default([])
  enabled         Boolean  @default(true)
  lastUsedAt      DateTime?
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([userId, enabled])
  @@index([provider, model])
}

model WebsiteBookmark {
  id          String   @id @default(cuid())
  title       String
  url         String
  category    String
  subcategory String
  summary     String   @db.Text
  tags        String[] @default([])
  note        String?  @db.Text
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, updatedAt])
  @@index([category, subcategory])
}

model DailyPlanItem {
  id          String          @id @default(cuid())
  planDate    DateTime        @db.Date
  weekStartDate DateTime      @db.Date
  title       String
  note        String?         @db.Text
  status      DailyPlanStatus @default(TODO)
  priority    DailyPlanPriority @default(MEDIUM)
  quadrant    DailyPlanQuadrant @default(SCHEDULE)
  plannedTime String?
  dueDate     DateTime?       @db.Date
  estimateMinutes Int?
  completedAt DateTime?
  reviewNote  String?         @db.Text
  source      String          @default("MANUAL")
  sortOrder   Int             @default(0)
  authorId    String
  author      User            @relation(fields: [authorId], references: [id], onDelete: Cascade)
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([authorId, planDate, sortOrder])
  @@index([authorId, weekStartDate, quadrant])
  @@index([authorId, status])
}

model WorkbenchSession {
  id             String                 @id @default(cuid())
  authorId       String
  author         User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  toolId         String
  title          String
  status         WorkbenchSessionStatus @default(DRAFT)
  prompt         String                 @default("") @db.Text
  inputSnapshot  Json
  outputSnapshot Json
  imageAssetIds  String[]               @default([])
  externalJobId  String?
  errorMessage   String?                @db.Text
  completedAt    DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@index([authorId, toolId, updatedAt])
  @@index([authorId, status, updatedAt])
}

model CreativeSkill {
  id        String   @id @default(cuid())
  authorId  String?
  author    User?    @relation(fields: [authorId], references: [id], onDelete: Cascade)
  ownerType String
  name      String
  category  String
  enabled   Boolean  @default(true)
  deletedAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  versions  CreativeSkillVersion[]

  @@index([authorId, updatedAt])
  @@index([ownerType, enabled])
}

model CreativeSkillVersion {
  id          String   @id @default(cuid())
  skillId     String
  skill       CreativeSkill @relation(fields: [skillId], references: [id], onDelete: Cascade)
  version     Int
  config      Json
  createdAt   DateTime @default(now())
  canvasNodes CreativeCanvasNode[]

  @@unique([skillId, version])
}

model CreativeCanvasSession {
  id        String   @id @default(cuid())
  authorId  String
  author    User     @relation(fields: [authorId], references: [id], onDelete: Cascade)
  title     String
  status    String   @default("DRAFT")
  viewport  Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nodes     CreativeCanvasNode[]
  edges     CreativeCanvasEdge[]
  runs      CreativeCanvasRun[]

  @@index([authorId, updatedAt])
}

model CreativeCanvasNode {
  id             String   @id @default(cuid())
  sessionId      String
  session        CreativeCanvasSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  clientId       String
  kind           String
  position       Json
  snapshot       Json
  skillVersionId String?
  skillVersion   CreativeSkillVersion? @relation(fields: [skillVersionId], references: [id], onDelete: SetNull)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([sessionId, clientId])
}

model CreativeCanvasEdge {
  id           String   @id @default(cuid())
  sessionId    String
  session      CreativeCanvasSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sourceNodeId String
  targetNodeId String
  role         String
  createdAt    DateTime @default(now())

  @@unique([sessionId, sourceNodeId, targetNodeId, role])
}

model CreativeCanvasRun {
  id           String   @id @default(cuid())
  sessionId    String
  session      CreativeCanvasSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  nodeId       String?
  kind         String
  status       String
  input        Json
  output       Json
  errorMessage String?  @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model LoginAudit {
  id          String   @id @default(cuid())
  identifier String
  userId      String?
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  outcome     String
  reason      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  @@index([identifier, createdAt])
  @@index([userId, createdAt])
  @@index([outcome, createdAt])
}
